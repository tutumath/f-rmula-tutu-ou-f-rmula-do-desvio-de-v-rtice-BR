*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:"Newsreader",Georgia,"Times New Roman",serif; font-size:19px; line-height:1.6;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:28px 28px;
}
main{max-width:720px; margin:0 auto; padding:32px 20px 64px}
h1{font-size:clamp(2.1rem,7vw,3.2rem); line-height:1.08; margin:0 0 6px; font-weight:600; letter-spacing:-0.01em}
h2{font-size:1.45rem; margin:44px 0 8px; font-weight:600}
p{margin:0 0 14px; max-width:62ch}
.by{color:var(--muted); margin:0 0 22px}
.card{background:var(--paper); border:1px solid var(--line); border-radius:6px; padding:18px 20px; margin:16px 0; overflow-x:auto}
.formula{font-size:clamp(1.3rem,5vw,1.9rem); text-align:center; padding:26px 12px; white-space:nowrap}
.formula small{display:block; font-size:.95rem; color:var(--muted); margin-top:10px; white-space:normal}
.math{font-style:italic}
.frac{display:inline-flex; flex-direction:column; text-align:center; vertical-align:middle; line-height:1.25; margin:0 2px}
.frac>span:first-child{border-bottom:1.5px solid currentColor; padding:0 4px}
.frac>span:last-child{padding:0 4px}
.sqrt{display:inline-flex; align-items:center}
.sqrt>span{border-top:1.5px solid currentColor; padding:0 3px; margin-left:1px}
.sqrt::before{content:"√"; font-style:normal}
.eq{display:block; text-align:center; margin:10px 0; font-size:1.2rem; white-space:nowrap}
.note{border-left:4px solid var(--accent2); padding:4px 0 4px 16px; margin:22px 0}
.note p{margin:0 0 8px}
ol.steps{padding-left:22px; margin:0 0 10px}
ol.steps li{margin-bottom:6px}
figure{margin:20px 0}
svg{width:100%; height:auto; display:block}
.ax{stroke:var(--muted); stroke-width:1.3}
.cv{stroke:var(--accent); stroke-width:3.2; fill:none}
.dash{stroke:var(--accent2); stroke-width:2; stroke-dasharray:6 5; fill:none}
.arr{stroke:var(--accent2); stroke-width:2.4; fill:none}
.dot{fill:var(--accent2)}
