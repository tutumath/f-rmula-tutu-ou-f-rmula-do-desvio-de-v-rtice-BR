<style>
:root{
  --bg:#f2f5f9; --paper:#ffffff; --ink:#1b2740; --muted:#55627a; --line:#d3dbe6;
  --accent:#0d7a6b; --accent2:#b4492f; --grid:#e3e9f1;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1624; --paper:#162033; --ink:#e6ecf7; --muted:#9aa8c2; --line:#2a3750;
    --accent:#4fd1bd; --accent2:#f0997f; --grid:#1b273d; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1624; --paper:#162033; --ink:#e6ecf7; --muted:#9aa8c2; --line:#2a3750;
  --accent:#4fd1bd; --accent2:#f0997f; --grid:#1b273d; color-scheme:dark;
}
